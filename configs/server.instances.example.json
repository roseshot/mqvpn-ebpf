{
  "instances": [
    {
      "name": "edge-a",
      "listen": "0.0.0.0:4433",
      "tun": "mq0",
      "peers": "/etc/mqvpn/peers-a.json",
      "path": "/.well-known/masque/ethernet/",
      "cert": "/etc/mqvpn/tls/a-server.crt",
      "key": "/etc/mqvpn/tls/a-server.key",
      "client_ca": "/etc/mqvpn/tls/a-clients.crt",
      "max_frame": 1160
    },
    {
      "name": "edge-b",
      "listen": "0.0.0.0:4434",
      "tun": "mq1",
      "peers": "/etc/mqvpn/peers-b.json",
      "path": "/.well-known/masque/ethernet/",
      "cert": "/etc/mqvpn/tls/b-server.crt",
      "key": "/etc/mqvpn/tls/b-server.key",
      "client_ca": "/etc/mqvpn/tls/b-clients.crt",
      "max_frame": 1160
    }
  ]
}
